{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielmongefranco/peerfoil/schemas/pack.schema.json",
  "$comment": "This file is part of PeerFoil. schemas/pack.schema.json. Author(s): Gabriel Mongefranco. Created: 2026-09-05. Last Modified: 2026-09-05. Summary: Validates a declarative PeerFoil project-pack manifest. A pack chooses artifacts, evidence, tools, review lenses, and completion requirements; it cannot run code, widen permissions, or weaken repository rules. Copyright © 2026 Gabriel Mongefranco. SPDX-License-Identifier: GPL-3.0-or-later.",
  "title": "PeerFoil project pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "summary",
    "artifacts",
    "typical_stages",
    "evidence",
    "review_lenses",
    "completion",
    "tools",
    "project_tool_hints"
  ],
  "properties": {
    "_project": { "const": "PeerFoil" },
    "_file": { "$ref": "common.schema.json#/$defs/metadata_field" },
    "_authors": { "$ref": "common.schema.json#/$defs/metadata_field" },
    "_created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "_modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "_summary": { "$ref": "common.schema.json#/$defs/metadata_field" },
    "_copyright": { "$ref": "common.schema.json#/$defs/metadata_field" },
    "_license": { "$ref": "common.schema.json#/$defs/metadata_field" },
    "record_type": { "const": "pack" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "status": { "type": "string", "enum": ["default", "starter", "example"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "typical_stages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "default_level", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
          "kind": { "$ref": "common.schema.json#/$defs/evidence_kind" },
          "default_level": { "$ref": "common.schema.json#/$defs/evidence_level" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "review_lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "focus"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "focus": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "completion": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool_probe" }
    },
    "project_tool_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marker", "command", "purpose"],
        "properties": {
          "marker": { "type": "string", "minLength": 1, "maxLength": 120 },
          "command": { "$ref": "#/$defs/command" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }
    },
    "tool_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "required", "purpose"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "command": { "$ref": "#/$defs/command" },
        "required": { "type": "boolean" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
